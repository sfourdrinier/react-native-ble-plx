{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ub4-perf-baseline-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultPath", "resultSha256", "capturedAt", "sourceWindow", "buildProvenance"],
  "properties": {
    "schemaVersion": {"const": "ub4-perf-baseline-receipt/v1"},
    "resultPath": {"type": "string", "pattern": "^benchmarks/results/[^/]+\\.json$"},
    "resultSha256": {"$ref": "#/$defs/sha256"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "sourceWindow": {"$ref": "#/$defs/sourceWindow"},
    "buildProvenance": {"$ref": "#/$defs/buildProvenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "dirty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isDirty", "changedPathCount", "statusNulSha256"],
          "properties": {
            "isDirty": {"type": "boolean"},
            "changedPathCount": {"$ref": "#/$defs/nonNegativeInteger"},
            "statusNulSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "sourceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "stable"],
      "properties": {
        "before": {"$ref": "#/$defs/sourceState"},
        "after": {"$ref": "#/$defs/sourceState"},
        "stable": {"type": "boolean"}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "buildModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after"],
      "properties": {
        "path": {"type": "string", "pattern": "^(lib|native)/"},
        "before": {"$ref": "#/$defs/fingerprint"},
        "after": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "buildProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocker", "modules"],
      "properties": {
        "status": {"const": "blocked"},
        "blocker": {"type": "string", "minLength": 1},
        "modules": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/buildModule"}}
      }
    }
  }
}
