{
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./",
    "paths": {
      "unified-ble-manager": ["./src/index"],
      "unified-ble-manager/backend-sdk": ["./src/backend-sdk"],
      "unified-ble-manager/cli": ["./src/cli"],
      "unified-ble-manager/testing": ["./src/testing"],
      "unified-ble-manager/codecs": ["./src/codecs"],
      "unified-ble-manager/profiles/commands": ["./src/profiles/commands"],
      "unified-ble-manager/profiles/standard-commands": ["./src/profiles/standard-commands"],
      "unified-ble-manager/profiles/heart-rate": ["./src/profiles/heart-rate"],
      "unified-ble-manager/profiles/battery-service": ["./src/profiles/battery-service"],
      "unified-ble-manager/profiles/device-information": ["./src/profiles/device-information"],
      "unified-ble-manager/profiles/health-thermometer": ["./src/profiles/health-thermometer"],
      "unified-ble-manager/profiles/blood-pressure": ["./src/profiles/blood-pressure"],
      "unified-ble-manager/profiles/ieee-11073": ["./src/profiles/ieee-11073"],
      "unified-ble-manager/react-native": ["./src/react-native"],
      "unified-ble-manager/node/bluez": ["./src/node-bluez"],
      "unified-ble-manager/node/corebluetooth": ["./src/node-corebluetooth"],
      "unified-ble-manager/node/winrt": ["./src/node-winrt"],
      "unified-ble-manager/electron/main": ["./src/electron-main"],
      "unified-ble-manager/electron/renderer": ["./src/electron-renderer"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["lib", "node_modules", "example", "example-expo", "integration-tests", "plugin", "android", "ios"]
}
