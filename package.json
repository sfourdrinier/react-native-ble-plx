{
  "name": "unified-ble-manager",
  "version": "4.0.0-alpha.0",
  "description": "Unified Bluetooth Low Energy manager for React Native, Electron, Web, and desktop (4.0 train; successor lineage of @sfourdrinier/react-native-ble-plx)",
  "packageManager": "pnpm@10.14.0",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "native",
    "docs",
    "ROADMAP.md",
    "ROADMAP.4.0.md",
    "plugin/build",
    "app.plugin.js",
    "*.podspec",
    "!docs/superpowers",
    "!docs/index.html",
    "!docs/assets",
    "!lib/typescript/example",
    "!lib/typescript/example-expo",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!native/**/build",
    "!native/**/*.node",
    "!native/**/obj.target",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "MIGRATION_4.0.md"
  ],
  "scripts": {
    "build": "babel src/ -d lib/",
    "test": "pnpm test:package",
    "test:package": "jest --config jest.config.js",
    "pack:shim": "node scripts/prepare-shim-pack.js --pack",
    "docs": "pnpm prepack && documentation build lib/module/index.js -o docs --config documentation.yml -f html",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"plugin/src/**/*.{ts,tsx}\" && pnpm typecheck",
    "prepack": "bob build",
    "verify:release": "bash scripts/verify-release.sh",
    "release": "release-it",
    "example": "pnpm --dir example",
    "build:android": "cd example/android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "test:android": "cd example/android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd example/ios && xcodebuild -workspace BlePlxExample.xcworkspace -scheme BlePlxExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "test:ios": "cd example/ios && xcodebuild -workspace BlePlxExample.xcworkspace -scheme BlePlxExample -configuration Debug -sdk iphonesimulator ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "test:tvos:library": "bash scripts/ci/check-tvos-library.sh",
    "test:expo": "pnpm --dir example-expo install --no-frozen-lockfile && pnpm --dir example-expo exec expo install --fix && pnpm --dir example-expo exec tsc --noEmit -p tsconfig.json && cd example-expo && npx expo-doctor && npx expo prebuild --clean --no-install",
    "build:expo:android": "pnpm --dir example-expo install --no-frozen-lockfile && cd example-expo && npx expo prebuild --clean --no-install && cd android && ./gradlew :app:assembleDebug --no-daemon --console=plain",
    "bootstrap": "pnpm --dir example install && pnpm install && pnpm --dir example pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build plugin/build lib",
    "build:plugin": "tsc --build plugin",
    "clean:plugin": "del-cli plugin/build",
    "test:plugin": "jest --config plugin/jest.config.js",
    "test:codemod": "node scripts/codemod/transform-bytes-path.js --check scripts/codemod/fixtures/before-read.js && node scripts/codemod/transform-bytes-path.js --check scripts/codemod/fixtures/before-read-safe.js && node scripts/codemod/transform-bytes-path.js --check scripts/codemod/fixtures/before-read-mixed.js",
    "build:electron:macos": "cd native/electron/corebluetooth && node-gyp rebuild --release",
    "example:web": "pnpm prepack && npx --yes vite --config example-web/vite.config.js",
    "example:electron": "pnpm prepack && electron example-electron/main.js",
    "example:electron:live": "pnpm run build:electron:macos && pnpm prepack && node example-electron/live-polar.js",
    "example:electron:ui:live": "pnpm run build:electron:macos && pnpm prepack && npx --yes @electron/rebuild -f -w native/electron/corebluetooth && ELECTRON_BLE_REQUIRE_NATIVE=1 electron example-electron/main.js",
    "example:electron:smoke": "pnpm prepack && node example-electron/smoke.js",
    "prepare": "pnpm clean:plugin && pnpm build:plugin",
    "lint:plugin": "eslint plugin/src/*"
  },
  "keywords": [
    "bluetooth",
    "ble",
    "unified-ble-manager",
    "react-native",
    "electron",
    "web",
    "corebluetooth",
    "gatt",
    "central"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfourdrinier/react-native-ble-plx.git"
  },
  "author": "sfourdrinier",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sfourdrinier/react-native-ble-plx/issues"
  },
  "homepage": "https://github.com/sfourdrinier/react-native-ble-plx#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.25.2",
    "@babel/preset-typescript": "^7.25.2",
    "@commitlint/config-conventional": "^17.0.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@evilmartians/lefthook": "^1.5.0",
    "@expo/config-plugins": "^57.0.0",
    "@react-native/eslint-config": "~0.86.0",
    "@react-native/jest-preset": "~0.86.0",
    "@react-native/metro-config": "~0.86.0",
    "@react-native/typescript-config": "~0.86.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-native-base64": "^0.2.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "babel-plugin-syntax-hermes-parser": "^0.15.1",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "documentation": "12.3.0",
    "electron": "43.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "expo": "^57.0.0",
    "expo-module-scripts": "^5.0.0",
    "globals": "^17.7.0",
    "hermes-eslint": "^0.15.1",
    "jest": "^29.7.0",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.1",
    "pod-install": "^0.1.0",
    "prettier": "^3.0.3",
    "react": "~19.2.0",
    "react-native": "~0.86.0",
    "react-native-base64": "^0.2.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-toast-message": "^2.1.6",
    "release-it": "^20.2.1",
    "styled-components": "^6.1.11",
    "turbo": "^1.10.7",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "codegenConfig": {
    "name": "BlePlxSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.sfourdrinier.unifiedblemanager"
    },
    "ios": {
      "modulesProvider": {
        "BlePlx": "BlePlx"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/integration-tests",
      "<rootDir>/example/node_modules",
      "<rootDir>/example-expo/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json",
    "./web": {
      "types": "./lib/typescript/src/hosts/web.d.ts",
      "react-native": "./src/hosts/web.ts",
      "import": "./lib/module/hosts/web.js",
      "require": "./lib/commonjs/hosts/web.js",
      "default": "./lib/commonjs/hosts/web.js"
    },
    "./electron": {
      "types": "./lib/typescript/src/hosts/electron.d.ts",
      "react-native": "./src/hosts/electron.ts",
      "import": "./lib/module/hosts/electron.js",
      "require": "./lib/commonjs/hosts/electron.js",
      "default": "./lib/commonjs/hosts/electron.js"
    },
    "./node": {
      "types": "./lib/typescript/src/hosts/node.d.ts",
      "react-native": "./src/hosts/node.ts",
      "import": "./lib/module/hosts/node.js",
      "require": "./lib/commonjs/hosts/node.js",
      "default": "./lib/commonjs/hosts/node.js"
    }
  },
  "optionalDependencies": {
    "dbus-next": "^0.10.2"
  }
}
