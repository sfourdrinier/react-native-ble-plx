# .gitignore

# OSX
#
.DS_Store

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace
.xcode.env.local

Pods/

# Android/IntelliJ
#
build/
.idea
.gradle
*.iml
*.swp
*.bat
local.properties

# node.js
#
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log*

# BUCK
buck-out/
\.buckd/
*.keystore
!example/android/app/debug.keystore

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

*/fastlane/report.xml
*/fastlane/Preview.html
*/fastlane/screenshots

# Bundle artifact
*.jsbundle
/.artifacts/
/lib
/test_project
/example-web/dist/
*.tsbuildinfo

# Example app installs via pnpm (bootstrap / CI). No committed lock yet:
# - pnpm-lock is local until we choose to pin it
# - yarn.lock is not used (stale Yarn v1 lock removed after floating RN ranges)
example/pnpm-lock.yaml
example/yarn.lock

# Generated by CocoaPods for the non-Expo example; regenerate locally on macOS.
example/vendor/bundle/
example/ios/Pods/
example/ios/build/
example/ios/Podfile.lock
